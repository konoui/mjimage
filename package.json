{
    "name": "@konoui/mjimage",
    "version": "0.4.0",
    "description": "Generates Mahjong tiles in SVG format.",
    "author": "konoui",
    "license": "MIT",
    "repository": "github.com/konoui/mjimage",
    "keywords": [
        "mahjong"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vite build",
        "test": "vitest run",
        "e2e": "tsx src/e2e/index.ts",
        "prepublishOnly": "npm update && npm run build"
    },
    "sideEffects": false,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist/",
        "!**/__tests__/"
    ],
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "devDependencies": {
        "@types/node": "^24.0.7",
        "buffer": "^6.0.3",
        "process": "^0.11.10",
        "svg-sprite": "^2.0.2",
        "svgo": "^3.0.2",
        "tsx": "^4.19.1",
        "typescript": "^5.5.4",
        "vite": "^6.0.6",
        "vite-plugin-dts": "^4.2.2",
        "vite-tsconfig-paths": "^5.0.1",
        "vitest": "^3.0.4"
    },
    "dependencies": {
        "eventmit": "^2.0.4",
        "fast-xml-parser": "^5.0.9",
        "transformation-matrix": "^3.0.0",
        "valibot": "^1.0.0",
        "xstate": "^5.7.0"
    }
}
