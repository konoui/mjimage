{
    "name": "@konoui/mjimage",
    "version": "1.0.0",
    "description": "Generates Mahjong tiles in SVG format.",
    "author": "konoui",
    "license": "MIT",
    "repository": "github.com/konoui/mjimage",
    "keywords": [
        "mahjong"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vite build",
        "build:browser": "vite build --config vite.config.browser.ts",
        "dev": "vite --config vite.config.browser.ts",
        "test": "vitest run",
        "e2e": "tsx src/e2e/index.ts",
        "svg-sprite": "svg-sprite -C svg-sprite.config.json -shape-transform-svgo svg-sprite.config.json public/svg/*.svg",
        "svgo": "./scripts/svgo.sh",
        "examples": "./scripts/gen-examples.sh",
        "deploy": "npm run build:browser && ./scripts/sync.sh personal",
        "prepublishOnly": "npm update && npm run build",
        "cmd": "tsx src/cmd/index.ts"
    },
    "sideEffects": false,
    "type": "module",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist/index.*"
    ],
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@types/node": "^24.1.0",
        "@types/yargs": "^17.0.33",
        "svg-sprite": "^2.0.2",
        "svgo": "^4.0.0",
        "tsx": "^4.19.1",
        "typescript": "^5.5.4",
        "vite": "^8.0.16",
        "vite-plugin-dts": "^4.2.2",
        "vitest": "^4.1.0",
        "yargs": "^17.7.2"
    },
    "dependencies": {
        "eventmit": "^3.0.0",
        "fast-xml-parser": "^5.0.9",
        "transformation-matrix": "^3.0.0",
        "valibot": "^1.0.0",
        "xstate": "^5.7.0"
    }
}
